{
  "name": "selfmedia-ds",
  "version": "0.3.23",
  "type": "module",
  "description": "自媒体AI工作台：对标分析、账号诊断、选题、内容生产、发布复盘串成一条线，数据和产出都落在本地工作区",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./bridge": "./bridge.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bridge.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "工作台模板/",
    "工作台版本.txt",
    "DEVELOPING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
