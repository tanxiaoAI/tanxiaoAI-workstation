{
  "name": "selfmedia-ds",
  "version": "0.3.16",
  "type": "module",
  "description": "自媒体AI工作台 DS 版：自带一套工作台（壳 + 工作台一起），与开源版各自独立",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./bridge": "./bridge.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bridge.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "工作台模板/",
    "工作台版本.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
